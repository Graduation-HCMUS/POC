{
  "name": "@packages/api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=config/.env.development --watch src/main.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "start": "node --env-file-if-exists=config/.env.production src/main.ts",
    "test": "node ../../scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "db:migrate": "node --env-file-if-exists=config/.env.development src/db/migrate.ts",
    "test:integration": "node --env-file-if-exists=config/.env.development --test tests/integration/postgres.integration.ts",
    "evaluate:classification": "node tests/evaluate-classification.ts"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "dependencies": {
    "@packages/contracts": "*",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.6.0",
    "express": "^5.3.0",
    "jet-logger": "3.0.0",
    "multer": "^2.1.1",
    "pg": "^8.16.0",
    "quickjs-emscripten": "^0.32.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.1",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
